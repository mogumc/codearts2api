# ============================================================
# codearts2api 配置示例
# 复制为 .env 后按需修改。已存在的环境变量优先于本文件。
# ============================================================

# ---------- 必填 ----------
# 华为云 AK/SK（https://console.huaweicloud.com/iam/#/mine/accessKey）
CODEARTS_AK=你的AccessKey
CODEARTS_SK=你的SecretKey

# ---------- 下游鉴权（强烈建议开启）----------
# 允许访问本代理的密钥，逗号或换行分隔。留空则不鉴权。
#
# 本代理消耗你华为云账号的额度，若监听地址暴露到网络且不设密钥，
# 任何知道地址的人都能白用。设置后客户端需带 Authorization: Bearer <key>。
# CODEARTS_API_KEYS=sk-xxxx1,sk-xxxx2

# ---------- 监听地址 ----------
# 默认 127.0.0.1:8787（仅本机可访问）。要对外提供服务改 host 为 0.0.0.0，
# 并务必同时设置 CODEARTS_API_KEYS。
# CODEARTS_PROXY_HOST=127.0.0.1
# CODEARTS_PROXY_PORT=8787

# ---------- 数据文件 ----------
# CODEARTS_MODEL_CACHE=models-cache.json
# CODEARTS_BENEFIT_STATE=benefit-state.json

# ---------- 自动签到 ----------
# 每天首个请求顺带签到一次（默认开启）。关闭设为 0 / false / off / no。
# CODEARTS_AUTO_CLAIM=1

# ============================================================
# 上游端点覆盖（默认官方地址，一般无需修改）
# ============================================================
# 用途：私有化部署、通过反向代理/中转访问、上游域名变更。
#
# 【重要】通过中转访问时，必须同时设置对应的 *_BASE_HOST！
#
# 华为云网关按它收到的 Host 头验签。若只改 BASE_URL 而不改 BASE_HOST，
# 签名里的 host 会是中转域名，与上游认定的域名不一致 → 验签失败，
# 表现为 401 / APIG.0301（Incorrect IAM authentication information）。
#
# 配置方法：BASE_URL 填中转地址（实际连接的地址），
#           BASE_HOST 填上游真实域名（签名用的域名）。
#
# 示例（中转域名为 relay.example.com，路径前缀 /codearts 与 /opengw）：
# CODEARTS_BASE_URL=https://relay.example.com/codearts
# CODEARTS_BASE_HOST=snap-access.cn-north-4.myhuaweicloud.com
# CODEARTS_OPENGW_BASE_URL=https://relay.example.com/opengw
# CODEARTS_OPENGW_BASE_HOST=opengw.developer.huaweicloud.com
#
# 直连官方地址时这两项留空即可，签名 host 会自动取 BASE_URL 的域名。

# CODEARTS_BASE_URL=https://snap-access.cn-north-4.myhuaweicloud.com
# CODEARTS_OPENGW_BASE_URL=https://opengw.developer.huaweicloud.com

# 签名 host（只写主机名，不要带 http:// 前缀或路径）
# CODEARTS_BASE_HOST=snap-access.cn-north-4.myhuaweicloud.com
# CODEARTS_OPENGW_BASE_HOST=opengw.developer.huaweicloud.com
